# Configure these only after creating a dedicated Supabase project for Masjid Amanah.
# Never place a Supabase service_role or secret key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile protects the public contact inquiry form.
# The site key is public; the secret key must remain server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated allowed Turnstile response hostnames, e.g. localhost, www.your-approved-domain.tld
# Replace localhost with the approved production hostname before launch.
TURNSTILE_ALLOWED_HOSTNAMES=
