# Configure these only after creating a dedicated Supabase project for Masjid Amanah.
# Never place a Supabase secret key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret. Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=

# Production website URL (set only after the approved domain is connected).
NEXT_PUBLIC_SITE_URL=
# Keep false until mosque management approves the public content and domain.
PUBLIC_CONTENT_APPROVED=false

# Cloudflare Turnstile protects the public contact inquiry form.
# Contact submissions are inserted server-side with the secret key only after token verification.
# The site key is public; the secret key must remain server-side only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated allowed Turnstile response hostnames, e.g. localhost, www.your-approved-domain.tld
# Replace localhost with the approved production hostname before launch.
TURNSTILE_ALLOWED_HOSTNAMES=
